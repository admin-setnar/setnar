# Canonical public origin, used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://setnar.com

# Default tenant used when the incoming Host does not match any known tenant
# (local development, previews, custom domains not yet mapped).
NEXT_PUBLIC_DEFAULT_TENANT=setnar

# Supabase public configuration. These two values may enter the browser bundle;
# the privileged key below must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used exclusively by the dedicated Analytics and lead write
# adapters. Never prefix with NEXT_PUBLIC_, expose to client code, or reuse for
# ordinary repositories.
# Configure in Vercel Production. In Preview, use only a disposable Supabase
# project when lead writes are intentionally exercised; never point tests at
# production data.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Salts the e-mail/IP hashes the login rate limiter writes to
# `login_attempts`, so that table never stores either in plain text. Any long
# random string; see supabase/README.md before rotating it.
LOGIN_ATTEMPT_SALT=

# Server-only. Salts the `ip_hash` written to `analytics_events` by
# record_page_visit/record_whatsapp_click. Deliberately its own value, never
# equal to LOGIN_ATTEMPT_SALT — see ADR-054 in README.md: a shared salt would
# let a visitor's analytics ip_hash be matched against their login/lead
# ip_hash, a cross-table correlation the analytics LGPD posture forbids. Any
# long random string, different from LOGIN_ATTEMPT_SALT.
ANALYTICS_IP_SALT=

# Server-only. Asaas gateway credentials (SET-27) — read exclusively by
# asaas-payment-gateway-factory.ts. ASAAS_BASE_URL is the sandbox host while
# testing, the production host once live; never hardcode either.
#
# ASAAS_API_KEY starts with a literal `$` (Asaas's own Sandbox/production key
# format, e.g. `$aact_...::...::$aach_...`) — escape every `$` in the value as
# `\$` here. Next.js's built-in .env loader (@next/env, dotenv-expand-style
# `$VAR`/`${VAR}` interpolation) otherwise reads an unescaped `$` as the start
# of a variable reference; since no such variable exists, it silently
# collapses the ENTIRE key to an empty string at runtime — no error, no
# warning, just `ASAAS_API_KEY is not configured.` from
# asaas-payment-gateway-factory.ts as if the value were never set. Confirmed
# by running @next/env's actual interpolation function against a real
# Sandbox key: unescaped -> "", `\$`-escaped -> the key survives intact.
ASAAS_API_KEY=
ASAAS_BASE_URL=

# Server-only. Compared against the `asaas-access-token` header on every
# inbound Asaas webhook call (SET-29) — see verify-asaas-webhook-token.ts.
# Generate a random string of at least 32 characters, no whitespace, no
# 4-repeated-letter or numeric sequences (Asaas's own complexity rule since
# 2026-03), and configure the exact same value as the Webhook's auth token in
# the Asaas dashboard — see supabase/README.md for the full setup steps.
ASAAS_WEBHOOK_TOKEN=
