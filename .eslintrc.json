{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/consistent-type-imports": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/modules/*/infrastructure/**",
              "!@/modules/*/infrastructure/*-factory"
            ],
            "message": "Depend on the domain port and obtain the adapter from the module's *-factory (its composition root). Reaching into infrastructure directly couples the caller to a replaceable detail."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/modules/*/infrastructure/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}